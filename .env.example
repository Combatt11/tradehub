# =========================================================
# NexusMarket - variables de entorno (copiar como .env)
# =========================================================

# --- MySQL 8 ---
DB_URL=jdbc:mysql://localhost:3306/nexusmarket?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=nexusmarket
DB_PASSWORD=nexusmarket
DB_NAME=nexusmarket
DB_PORT=3306
MYSQL_ROOT_PASSWORD=root

# --- MongoDB 7 ---
MONGODB_URI=mongodb://nexusmarket:nexusmarket@localhost:27017/nexusmarket?authSource=admin
MONGODB_USERNAME=nexusmarket
MONGODB_PASSWORD=nexusmarket
MONGODB_DATABASE=nexusmarket
MONGODB_PORT=27017

# --- JWT ---
# Secreto SOLO para desarrollo (32 bytes en Base64). Regenerar en entornos reales:
#   openssl rand -base64 32
JWT_SECRET=Zcay4Pbqye9gBsBYw6ksksORVNXUibiIh1A+Nfey3QE=
# Expiracion del access token en milisegundos (900000 = 15 minutos).
JWT_EXPIRATION=900000
